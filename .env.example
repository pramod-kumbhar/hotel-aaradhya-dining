# Hotel Aaradhya Dining configuration

# Owner vault PIN passcode (4-6 digits)
VITE_OWNER_PIN=

# Turso Cloud database connection
TURSO_DATABASE_URL=libsql://your-database-name-your-org.aws-region.turso.io
TURSO_AUTH_TOKEN=your_turso_database_auth_token

# SMTP server connection settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your_16_character_app_password

# Hotel owner target email addresses, separated by comma
VITE_OWNER_EMAIL=owner@example.com
